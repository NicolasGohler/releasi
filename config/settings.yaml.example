# Copy this file to config/settings.yaml and adjust values
db_url: "sqlite+aiosqlite:///data/linauto.db"

# Working hours (actions only execute during these hours)
work_days: [0, 1, 2, 3, 4]  # Mon-Fri
work_start_hour: 9
work_end_hour: 17

# Daily variation on start/end times (minutes offset)
work_start_variation: [-30, 45]   # e.g., start between 8:30 and 9:45
work_end_variation: [-45, 30]     # e.g., end between 16:15 and 17:30

# Clustered timing — sessions (bursts) of activity per day
sessions_per_day: [3, 6]          # 3-6 sessions per day
actions_per_session: [2, 6]       # 2-6 connection requests per session
intra_session_delay: [120, 480]   # 2-8 min between actions in same session
inter_session_delay: [2700, 7200] # 45min-2hr between sessions

# Warm-up schedule: [min_per_day, max_per_day] per week
# After this ramp completes, no artificial cap is applied (runs until LinkedIn blocks)
warmup_schedule:
  - [8, 12]    # Week 1
  - [10, 14]   # Week 2
  - [14, 18]   # Week 3

# Cooldown (when weekly limit is hit, resume on Monday between these hours)
cooldown_resume_hour_min: 8
cooldown_resume_hour_max: 11

# Weekend activity (profile views and likes only, no connection requests)
weekend_enabled: true
weekend_profile_views: [3, 8]
weekend_likes: [1, 4]

# Browsing noise between sessions (profile views, feed likes)
noise_profile_views_per_session: [1, 3]
noise_feed_likes_per_session: [0, 2]

# Anti-detection
stealth_enabled: true
default_timezone: "Europe/Berlin"

# Page interaction delays (seconds)
page_load_delay_min: 1.0
page_load_delay_max: 3.0

# Typing speed (milliseconds per character)
typing_delay_min_ms: 50
typing_delay_max_ms: 150

# Residential proxy (IPRoyal) — set credentials once, then just
# assign proxy_country per account (e.g., "ca-montreal", "de-berlin")
# proxy_username: "your_iproyal_username"
# proxy_password: "your_iproyal_base_password"  # Without _country-xx params
# proxy_hostname: "geo.iproyal.com"
# proxy_port: 12321
# proxy_lifetime: "168h"   # Sticky session duration (168h = 7 days)

# Browser pool (persistent browsers for session keep-alive)
# Keeps Chromium instances alive across scheduler jobs, preserving
# cookies that accumulate naturally (bcookie, JSESSIONID, etc.)
pool_max_browsers: 3              # Max concurrent persistent browsers
pool_keepalive_interval_hours: 2.5 # How often to ping LinkedIn to prevent session timeout

# Browser
browser_headless: true
browser_viewport_width: 1920
browser_viewport_height: 1080
browser_locale: "en-US"

# Acceptance checking (daily at acceptance_check_hour)
acceptance_check_hour: 10  # Run once daily at 10:00

# Follow-up
default_followup_delay_hours: 24

# Logging
log_level: "INFO"
log_file: "data/logs/linauto.log"
